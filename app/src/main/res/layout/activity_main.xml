<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XIAOMI" android:textColor="@color/orange" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POWER MENU" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="32sp" android:layout_marginTop="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contrôle avancé • 14T Pro • HyperOS" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIONS D’ALIMENTATION" android:textColor="@color/orange" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="28dp" android:layout_marginBottom="10dp"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="22dp" app:strokeColor="#33FF7900" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/shutdownButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="⏻   ÉTEINDRE" android:textStyle="bold" android:textColor="@color/black" app:backgroundTint="@color/orange" app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/rebootButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="↻   REDÉMARRER" android:textStyle="bold" android:textColor="@color/orange" app:backgroundTint="@color/surface" app:strokeColor="@color/orange" app:strokeWidth="1dp" app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/recoveryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="RECOVERY" android:textStyle="bold" android:textColor="@color/orange" app:backgroundTint="@color/surface" app:strokeColor="#66FF7900" app:strokeWidth="1dp" app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/fastbootButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="FASTBOOT / BOOTLOADER" android:textStyle="bold" android:textColor="@color/orange" app:backgroundTint="@color/surface" app:strokeColor="#66FF7900" app:strokeWidth="1dp" app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/softRebootButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="SOFT REBOOT" android:textStyle="bold" android:textColor="@color/orange" app:backgroundTint="@color/surface" app:strokeColor="#66FF7900" app:strokeWidth="1dp" app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/systemUiButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="RELANCER SYSTEM UI" android:textStyle="bold" android:textColor="@color/orange" app:backgroundTint="@color/surface" app:strokeColor="#66FF7900" app:strokeWidth="1dp" app:cornerRadius="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIDGETS ÉCRAN D’ACCUEIL" android:textColor="@color/orange" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="26dp"/>
        <TextView android:id="@+id/widgetHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="5dp" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chaque action sensible demande une confirmation." android:textColor="@color/muted" android:textSize="12sp" android:layout_gravity="center_horizontal" android:layout_marginTop="22dp" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
